os="$(uname)"
other_hostname="${1:=local}"
boot="${2:=n}"

case "$os" in
Darwin)
  nix_hostname="$(scutil --get LocalHostName)"
  config_dir="$HOME/.config/nixpkgs"
  ;;
Linux)
  nix_hostname="$(hostname -s)"
  config_dir="/etc/nixos"
  ;;
*)
  echo "Unsupported OS"
  exit 1
  ;;
esac

pushd "$config_dir" || exit
rm -f result

if [ -z "$DIRENV_DIR" ]; then
  eval "$(direnv export zsh 2>/dev/null)"
fi

if [[ $boot == "y" ]]; then
  if [[ $other_hostname == "local" ]]; then
    just deploy-boot-local-machine "$nix_hostname"
  else
    remote_build="$(nix eval --json ".#deploy.nodes.${other_hostname}.remoteBuild" 2>/dev/null)"

    just deploy-boot-remote-machine "$other_hostname" "$remote_build"
  fi
else
  if [[ $other_hostname == "local" ]]; then
    just deploy-local-machine "$nix_hostname"
  else
    remote_build="$(nix eval --json ".#deploy.nodes.${other_hostname}.remoteBuild" 2>/dev/null)"

    just deploy-remote-machine "$other_hostname" "$remote_build"
  fi
fi

rm -f result
popd || exit

